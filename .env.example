# =============================================================================
# Docker / Portainer environment (source of truth for containers)
# =============================================================================
# Local:    copy to `.env` next to docker-compose.yml  →  make env
# Portainer: paste into Stack → Environment variables
#
# Compose interpolates these into the php service environment.
# backend/.env is only for running Symfony outside Docker (optional).
# Never commit real secrets.
# =============================================================================

# --- App ---
APP_ENV=dev
APP_SECRET=changeme_in_production_must_be_32_chars_long
APP_DEBUG=1

# --- Database (PHP container) ---
DATABASE_URL=mysql://user:password@mysql:3306/challenge_picker_db?serverVersion=8.0

# --- MySQL service ---
MYSQL_DATABASE=challenge_picker_db
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword

# --- JWT ---
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme_jwt_passphrase
JWT_TTL=3600

# --- OAuth (replace placeholders for real login) ---
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:8090/api/user/connect/discord/callback
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_REDIRECT_URI=http://localhost:8090/api/user/connect/twitch/callback

# --- App URLs ---
# FRONTEND_URL defaults to http://localhost:${FRONTEND_PORT} in compose if unset.
# If you change FRONTEND_PORT in Portainer, either omit FRONTEND_URL or set both.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8090
DEFAULT_URI=http://localhost:8090
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# --- Optional integrations ---
STEAM_API_KEY=your_steam_api_key_here
MAILER_DSN=null://null
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Frontend (Nuxt proxy to nginx service) ---
API_HOST=http://nginx:80
NODE_ENV=development

# --- Published host ports ---
# Change FRONTEND_PORT in Portainer to avoid collisions (e.g. 3001).
# Compose then defaults FRONTEND_URL to http://localhost:<FRONTEND_PORT> when FRONTEND_URL is unset.
FRONTEND_PORT=3000
NGINX_PORT=8090
MYSQL_PORT=3307
PHPMYADMIN_PORT=8080
